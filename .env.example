APP_NAME=Daily Intelligence Platform
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Optional: use this when the frontend and backend are deployed on separate origins.
# Comma-separate multiple allowed origins.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=replace-with-your-ai-api-key
NEWS_API_KEY=replace-with-your-news-api-key
MARKET_DATA_PROVIDER=alphavantage
MARKET_DATA_API_KEY=replace-with-your-market-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_TO=your-email@example.com
SMTP_PASS=replace-with-your-smtp-app-password
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id
DAILY_REPORT_CRON=0 7 * * *
SCHEDULER_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
